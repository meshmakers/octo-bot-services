<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AssemblyName>Meshmakers.Octo.Backend.Jobs</AssemblyName>
        <IsPackable>true</IsPackable>
        <PackageId>Meshmakers.Octo.Backend.Jobs</PackageId>
        <RootNamespace>Meshmakers.Octo.Backend.Jobs</RootNamespace>
        <OutputPath>..\..\bin\$(Configuration)\</OutputPath>
        <DocumentationFile>..\..\bin\$(Configuration)\$(AssemblyName).xml</DocumentationFile>
        <NoWarn>1701;1702;CS8002</NoWarn>
        <Configurations>Debug;Release;DebugL</Configurations>
        <Platforms>AnyCPU</Platforms>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Hangfire.Core" Version="1.8.22" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\assets\meshmakers64.png">
            <Pack>True</Pack>
            <PackagePath />
            <Link>meshmakers64.png</Link>
        </None>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Meshmakers.Octo.Services.Contracts" Version="$(OctoVersion)" />
        <ProjectReference Include="..\RepositoryUpdate\RepositoryUpdate.csproj" />
    </ItemGroup>


</Project>