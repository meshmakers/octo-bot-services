<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <ApplicationIcon />
        <AssemblyName>Meshmakers.Octo.Backend.BotServices</AssemblyName>
        <Description>The Bot services of OctoMesh</Description>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <IsPackable>false</IsPackable>
        <OutputType>Exe</OutputType>
        <RootNamespace>Meshmakers.Octo.Backend.BotServices</RootNamespace>
        <StartupObject />
        <UserSecretsId>173d8e91-b831-4e8a-a43f-672c57e6a4da</UserSecretsId>
        <OutputPath>..\..\bin\$(Configuration)\</OutputPath>
        <DocumentationFile>..\..\bin\$(Configuration)\$(AssemblyName).xml</DocumentationFile>
        <NoWarn>1701;1702;CS8002</NoWarn>
        <Configurations>Debug;Release;DebugL</Configurations>
        <Platforms>AnyCPU</Platforms>
        <CopyDocumentationFilesFromPackages>true</CopyDocumentationFilesFromPackages>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Hangfire.Mongo" Version="1.16.2" />
        <PackageReference Include="Duende.AspNetCore.Authentication.OAuth2Introspection" Version="7.0.1" />
        <!-- direct reference: the released SDK still ships the legacy IdentityModel until the next libs train -->
        <PackageReference Include="Duende.IdentityModel" Version="8.1.0" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.11" />
        <PackageReference Include="NLog.Web.AspNetCore" Version="6.2.0" />
        <PackageReference Include="tusdotnet" Version="2.11.2" />
        <PackageReference Include="Hangfire.AspNetCore" Version="1.8.25" />
        <PackageReference Include="Meshmakers.Octo.Services.Swagger" Version="$(OctoCoreLibVersion)" />
        <PackageReference Include="Meshmakers.Octo.Services.Notifications" Version="$(OctoCoreLibVersion)" />
        <PackageReference Include="Meshmakers.Octo.Services.Infrastructure" Version="$(OctoCoreLibVersion)" />
        <PackageReference Include="Meshmakers.Octo.Services.Observability" Version="$(OctoCoreLibVersion)" />
        <!-- AB#4230: direct CrateDB stream-data access for the archive data export/import jobs. -->
        <PackageReference Include="Meshmakers.Octo.Runtime.Engine.CrateDb" Version="$(OctoCoreLibVersion)" />
        <PackageReference Include="Meshmakers.Octo.ConstructionKit.Models.StreamData" Version="$(OctoCoreLibVersion)" />
        <!-- AB#5867 (N7): direct, floating reference on purpose. This host is the ONLY one that runs the
             MassTransit Hangfire scheduler (AddHangfireMessageScheduler), so the scheduler topology it gets
             is decided by the DistributionEventHub version resolved HERE. Transitively (via
             Services.Contracts) NuGet picks the LOWEST version the contracts package was packed against,
             not the newest on the feed: the 0.2-dev image of 2026-10-07 shipped DEH 0.2.2610.7002 although
             0.2.2610.8006 (instance-scoped "dev-hangfire" queue) was published, so dev and main kept
             sharing the legacy "hangfire" queue and RabbitMQ round-robined every schedule between the two
             bot services (test-2-dev: job lost on every second re-registration). Pinned by
             HangfireSchedulerTopologyGuardTests. -->
        <PackageReference Include="Meshmakers.Octo.Common.DistributionEventHub" Version="$(OctoCoreLibVersion)" />
        <ProjectReference Include="..\BotServices.Resources\BotServices.Resources.csproj" />
        <ProjectReference Include="..\Jobs\Jobs.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- AB#5054: lets the test project reach ConfigureJwtBearerOptions, which is internal like
             every other configurator here. Without it the JWT bearer wiring of this host — including
             the AuthenticationType label a security gate depends on — has no test coverage at all. -->
        <InternalsVisibleTo Include="Meshmakers.Octo.Backend.Jobs.Tests" />
    </ItemGroup>

    <ItemGroup>
        <Content Update="wwwroot\css\swagger.css">
            <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
    </ItemGroup>

</Project>