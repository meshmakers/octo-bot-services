<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AssemblyName>Meshmakers.Octo.Backend.Jobs.Tests</AssemblyName>
        <RootNamespace>Meshmakers.Octo.Backend.Jobs.Tests</RootNamespace>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <Configurations>Debug;Release;DebugL</Configurations>
        <Platforms>AnyCPU</Platforms>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="NSubstitute" Version="6.2.0" />
        <PackageReference Include="NSubstitute.Analyzers.CSharp" Version="1.0.17">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="TUnit" Version="1.65.63" />
        <!-- AB#5060: the tenant-routed job endpoints must be exercised through the real request
             pipeline — the transport tenant gate is middleware, so a controller called directly
             proves nothing about who may reach it. TestHost hosts the two JobsControllers in
             process, with no Mongo, Hangfire server or broker. -->
        <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.11" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Jobs\Jobs.csproj" />
        <!-- AB#5054: this repo has no test project for the service host, so the host's JWT bearer
             wiring was untestable. Added here rather than as a new project because Jobs.Tests is
             already the repo's only unit-test assembly. -->
        <ProjectReference Include="..\..\src\BotServices\BotServices.csproj" />
    </ItemGroup>

</Project>
